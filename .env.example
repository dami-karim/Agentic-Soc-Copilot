# Agentic SOC Co-Pilot — environment template
# Copy to the project root as `.env` and to `lab/` as `lab/.env`
#   cp .env.example .env
#   cp .env.example lab/.env
#
# The root .env is loaded automatically by the src package (src/__init__.py).
# lab/.env is read by Docker Compose for container credentials.

# ── OpenSearch ────────────────────────────────────────────────────────────────
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_HOST=localhost
# Must be set BEFORE the first `docker compose up` — it seeds the admin password
OPENSEARCH_PASSWORD=change-me-please

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# Must match what you set before the first `docker compose up`
NEO4J_PASSWORD=change-me-please

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_HOST=localhost

# ── LLM provider ──────────────────────────────────────────────────────────────
# Which backend to use: ollama | openai | vllm | anthropic
LLM_PROVIDER=ollama

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# ── vLLM (alternative backend, if LLM_PROVIDER=vllm) ──────────────────────────
VLLM_API_KEY=

# ── Optional: offline embeddings (no Hugging Face download at runtime) ───────
TRANSFORMERS_OFFLINE=1
